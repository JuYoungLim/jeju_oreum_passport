# Store dashboard name: jeju-oreum-passport-blob (must be Private).
# On Vercel, connect this store to the project. OIDC configuration is automatic.
# BLOB_STORE_ID must be the actual store ID, not its dashboard name.
BLOB_STORE_ID=
# Optional alternative: server-only read-write token, never exposed to browser code.
BLOB_READ_WRITE_TOKEN=
